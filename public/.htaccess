# Praba Leather Bali — security headers (Hostinger Shared Hosting)
# HSTS, same-origin framing, nosniff, referrer, and permission tightening.

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Custom 404
ErrorDocument 404 /404.html

# Keep static Next.js assets compatible with strict nosniff browsers.
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
</IfModule>

# Gzip text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets for 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/ico "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# HTML must be revalidated after a deployment. Hashed Next.js assets can stay
# cached for a year, but caching HTML indefinitely can mix build manifests and
# make the browser request chunks that no longer exist.
<FilesMatch "\.(html|txt)$">
  Header always set Cache-Control "no-cache, no-store, must-revalidate"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</FilesMatch>
