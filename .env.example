# Production Supabase project. Keep the URL and anon key from the same project.
NEXT_PUBLIC_SUPABASE_URL=https://hwjzofbbdpaqmnxycewz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# R2 browser upload gateway. This is a public Worker URL; never put R2
# access keys or secret keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_R2_UPLOAD_URL=https://your-r2-upload-worker.example.workers.dev
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://assetpraba.prvtech.site

# The storefront reads Supabase directly; no DATABASE_URL is needed on Hostinger.
DATA_SOURCE_DRIVER=supabase
OUTPUT_MODE=standalone

# Optional local-only database fallback. Do not set this to localhost in production.
# DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
# DATABASE_SSL=true

# Only local maintenance scripts need this privileged key. Never add it to a
# browser deployment or expose it in a screenshot.
# SUPABASE_SERVICE_ROLE_KEY=
