# Build-time public Supabase catalog access (recommended for static export)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# R2 browser upload gateway. This is a public Worker URL; never put R2
# access keys or secret keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_R2_UPLOAD_URL=https://your-r2-upload-worker.example.workers.dev
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=https://assetpraba.prvtech.site

# Optional direct Postgres fallback for build-time catalog reads
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
DATABASE_SSL=true
DATA_SOURCE_DRIVER=postgres
